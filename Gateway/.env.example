# ==============================================================================
# Smart Workstation - Raspberry Pi Gateway Configuration
# Course: 2110356 Embedded System (CEDT)
# ==============================================================================

# MQTT Broker Settings
MQTT_BROKER=localhost
MQTT_PORT=1883

# Hardware Mode (Set to 1 or true to simulate without Raspberry Pi GPIO / I2C)
MOCK_HARDWARE=0

# Alert Notifications (Optional - leave blank if not configured)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
LINE_NOTIFY_TOKEN=your_line_notify_token_here

